PORT=3300

# --- LinkedIn: https://www.linkedin.com/developers/apps ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3300/auth/linkedin/callback

# --- Meta (Facebook + Instagram): https://developers.facebook.com/apps ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3300/auth/facebook/callback

# --- X (Twitter): https://developer.twitter.com/en/portal/dashboard ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3300/auth/x/callback

# --- TikTok: https://developers.tiktok.com/apps ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3300/auth/tiktok/callback

# --- OpenRouter: https://openrouter.ai/keys (powers AI captions + comment replies) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# --- Optional: webhook fired after every publish attempt (e.g. an n8n webhook URL) ---
WEBHOOK_URL=

# --- Meta webhook verification token (for the inbound-DM auto-acknowledge feature) ---
# Set this to any random string, then register the same string when adding the
# webhook URL in your Meta App's Messenger/Instagram webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
